---
title: ERD Database Aplikasi Penggajian (Multi-Perusahaan)
---
erDiagram
  audit_logs {
    int id PK
    int company_id
    int user_id
    varchar action
    varchar entity_type
    int entity_id
    text old_values
    text new_values
    varchar ip_address
    datetime created_at
  }
  companies {
    int id PK
    varchar code
    varchar name
    text address
    varchar logo_path
    varchar signer_name
    varchar signer_title
    varchar signature_path
    bool is_active
    bool payroll_baru
    bool payroll_butuh_approval
    bool slip_pakai_password
    varchar prorata_dasar
  }
  departemen {
    int id PK
    varchar kode
    varchar nama
    int manager_id FK
    int company_id FK
    int pay_work_pattern_id FK
  }
  departemen_manager {
    int id PK
    int departemen_id FK
    int karyawan_id FK
    int company_id FK
  }
